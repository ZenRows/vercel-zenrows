{
  "name": "@zenrows/ai-sdk-tools",
  "version": "0.1.1",
  "description": "Zenrows web scraping tools for the Vercel AI SDK: scrape any URL, extract structured data, and take screenshots, with JavaScript rendering and anti-bot bypass.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.4.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --dts --format cjs,esm --clean",
    "test": "vitest",
    "format": "biome format --write .",
    "check": "biome check .",
    "typecheck": "tsc --noEmit",
    "example": "tsx --env-file-if-exists=.env examples/research-agent.ts",
    "check:live": "tsx --env-file-if-exists=.env examples/tools-only.ts"
  },
  "keywords": [
    "ai",
    "ai-sdk",
    "vercel",
    "tools",
    "tool-calling",
    "zenrows",
    "scraping",
    "web-scraping",
    "anti-bot"
  ],
  "author": "Zenrows",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZenRows/vercel-zenrows.git"
  },
  "homepage": "https://github.com/ZenRows/vercel-zenrows#readme",
  "bugs": "https://github.com/ZenRows/vercel-zenrows/issues",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "zenrows": "^2.0.3"
  },
  "peerDependencies": {
    "ai": "^7.0.0",
    "zod": "^3.25.76 || ^4.1.8"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.53",
    "@biomejs/biome": "1.8.1",
    "@types/node": "^26.5.1",
    "ai": "^7.0.101",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0",
    "zod": "^4.1.8"
  }
}
